# Salin ke .env (sudah di .gitignore, tidak pernah ke-commit) lalu isi nilai asli.
# Jangan pernah tempel key asli di chat/issue/PR — kalau sudah pernah, regenerate dulu di exchange.

# --- npm run debate (opsional, hanya kalau mau lapisan debat bull/bear) ---
ANTHROPIC_API_KEY=
# DEBATE_MODEL=claude-haiku-4-5        # opsional, model lebih murah dari default claude-opus-5

# --- npm run bot (wajib untuk eksekusi live/dry-run) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXEC_MODE=dry_run
# EXEC_MODE=live                        # HANYA set ini setelah dry_run divalidasi beberapa hari
# APPROVAL_TIMEOUT_MINUTES=30           # entry baru auto-expired kalau tidak diputuskan dalam waktu ini
# REQUIRE_APPROVAL=false                # HAPUS approval gate, entry baru langsung otomatis. Default true (aman).
# EQUITY_SNAPSHOT_MINUTES=5             # Opsional: catat equity tiap 5 menit ke office/execution/equity.jsonl untuk dashboard (1 panggilan getAccount per 5 menit). Default 0 = hanya saat bar close.

# BINANCE_FAPI=https://testnet.binancefuture.com   # arahkan ke testnet untuk uji coba tanpa uang asli

# --- npm run scheduler (opsional, laporan Head Trader jam 07:00 & 15:00 WIB) ---
# HEADTRADER_MODEL=claude-haiku-4-5    # hanya dipakai kalau AI = Anthropic

# --- Analis Sentimen (opsional, jadwal event crypto) ---
# COINMARKETCAL_API_KEY=               # daftar gratis di coinmarketcal.com/en/apidocument; dilewati kalau kosong
# SENTIMENT_MODEL=claude-haiku-4-5

# --- Notifikasi Telegram (npm run notify) ---
# 1) Chat @BotFather di Telegram -> /newbot -> salin token ke sini
# 2) Kirim pesan apa saja ke bot kamu, lalu jalankan: npm run notify:chatid
# 3) Tes: npm run notify:test   -> jalan terus: npm run notify
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NOTIFY_DAILY_LOSS_WARN_PCT=2          # peringatan saat rugi hari ini >= 2%
# NOTIFY_DAILY_LOSS_LIMIT_PCT=3         # samakan dengan batas rugi harian Risk Engine
# NOTIFY_REJECTED=false                 # true = kirim juga sinyal yang ditolak Risk Engine (bisa ramai)
# NOTIFY_DASHBOARD_URL=http://localhost:3000

# --- Layanan kantor (ikut jalan di npm run notify) ---
# NEWS_BLACKOUT_MINUTES=30              # bot.ts: tolak ENTRY BARU 30 menit sebelum/sesudah berita high-impact USD. Default 0 = mati.
# BOT_STALE_MINUTES=10                  # kirim peringatan kalau bot tidak memperbarui state.json selama ini
# NEWS_ALERT_MINUTES=30                 # kabari Telegram N menit sebelum berita high-impact
# REGIME_REFRESH_MINUTES=30
# WEEKLY_LAB=true                       # Lab R&D otomatis tiap Minggu 08:00 WIB (review tiap Minggu 21:00 WIB)
# CALENDAR_COUNTRIES=USD

# --- AI gratis / tanpa kartu kredit (debat, sentimen, laporan Head Trader) ---
# Dipilih otomatis: GEMINI_API_KEY ada -> Gemini, lalu OPENROUTER_API_KEY -> OpenRouter, terakhir Anthropic.
# LLM_PROVIDER=gemini                   # paksa: gemini | openrouter | anthropic
# GEMINI_API_KEY=                       # gratis di aistudio.google.com/apikey (free tier: data boleh dipakai Google untuk perbaikan produk)
# GEMINI_MODEL=                         # kosong = pilih otomatis model Flash yang tersedia
# OPENROUTER_API_KEY=                   # openrouter.ai/keys, top up bisa pakai crypto
# OPENROUTER_MODEL=openrouter/free      # model gratis (dibatasi per hari)

# --- Data crowd gratis (npm run crowd; ikut jalan di npm run notify tiap 30 menit) ---
# Funding, open interest, long/short top trader, taker buy/sell (Binance publik) + Fear & Greed (alternative.me)
# CROWD_FILTER=false                    # true = bot TOLAK entry yang searah dengan pasar "ramai". Default mati: hanya dicatat.
# CROWD_REFRESH_MINUTES=30
# CROWD_FUNDING_PCT=0.03                # ambang funding "ramai" (% per 8 jam)
# CROWD_OI_JUMP_PCT=5                   # OI naik >= 5% dalam 24 jam
# CROWD_LS_LONG=1.8                     # rasio long/short top trader dianggap berat long
# CROWD_LS_SHORT=0.8

# --- AI otomatis di npm run notify (aktif kalau GEMINI/OPENROUTER/ANTHROPIC key terisi) ---
# HEADTRADER_AUTO=true                  # laporan Head Trader 07:00 & 15:00 WIB ke Telegram + office/reports
# WEEKLY_DEBATE=true                    # debat AI atas kandidat scan mingguan (setelah discover, Minggu ~10:00 WIB)
# WEEKLY_DEBATE_TOP=5
